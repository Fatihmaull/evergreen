{
  "name": "@evergreen-stellar/cli",
  "version": "0.1.0",
  "private": false,
  "description": "Scan Soroban contracts for TTL health, projected archival, and rent cost.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fatihmaull/evergreen.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Fatihmaull/evergreen#readme",
  "bugs": {
    "url": "https://github.com/Fatihmaull/evergreen/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "evergreen": "./dist/evergreen.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "bundle": "esbuild src/bin.ts --bundle --platform=node --format=esm --external:@stellar/stellar-sdk --sourcemap --outfile=dist/evergreen.mjs",
    "prepack": "pnpm build && pnpm bundle"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@evergreen-stellar/core": "workspace:*",
    "@evergreen-stellar/shared-types": "workspace:*",
    "esbuild": "0.25.0"
  }
}
