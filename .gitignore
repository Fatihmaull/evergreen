# Secrets — never commit. See docs/CONVENTIONS.md § Secrets and keys.
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
secrets.json
stellar-keys.json
.stellar/
.soroban/

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo
.next/
.turbo/

# Rust / Soroban contract build output
target/
**/*.rs.bk

# Test / coverage
coverage/
.nyc_output/
*.lcov

# Local engine state (bump history, locks) — never a shared artifact
.evergreen/
evergreen.local.json

# Claude Code — the shared project settings file IS committed (it carries the
# commit-attribution rule, so it must reach every clone). Personal overrides
# are not.
.claude/settings.local.json

# Editors
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS noise
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# ...but a log committed as evidence is evidence. `*.log` above silently dropped
# both raw logs from #218 while `git commit` reported success and the document
# that links them merged green — the commit subject said "with its raw logs" and
# there were no logs. The two survivors under 2026-09-07-scheduler-runs/ were
# force-added, so the trap was worked around twice and never closed.
!docs/evidence/**/*.log
