{
  "name": "evergreen-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Soroban state-archival autopilot — monitor TTL, predict archival, extend automatically.",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "typecheck": "tsc --build --force && pnpm typecheck:shared-types",
    "build": "tsc --build",
    "cli": "pnpm build && node packages/cli/dist/bin.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage && pnpm test:ttl && pnpm test:scheduler && pnpm test:email && pnpm test:persistence && pnpm test:notion-sync && pnpm test:evidence-integrity && pnpm test:engine-output && pnpm test:engine-recorder && pnpm test:alert-journal && pnpm test:scheduler-watch && pnpm test:failure-rehearsal && pnpm test:crossing-capture && pnpm test:save-proof && pnpm test:proof-runtime && pnpm test:expiry-assessment",
    "test:ttl": "node --test --test-isolation=none scripts/verify-ttl-boundary.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "pnpm check:locale && pnpm check:links && pnpm check:schedule && pnpm check:cadence && pnpm check:conflicts && pnpm check:task-ids && pnpm check:policy && pnpm typecheck && pnpm check:bundle && pnpm check:publish && pnpm check:backlog && pnpm check:evidence && pnpm check:crossing && pnpm check:sow && pnpm check:workflows && pnpm lint && pnpm format:check && pnpm test",
    "scheduler:smoke": "node scripts/scheduler-smoke.mjs",
    "engine:run": "node scripts/engine-run.mjs",
    "test:scheduler": "node --test --test-isolation=none scripts/scheduler-smoke.test.mjs",
    "check:conflicts": "node scripts/check-conflict-markers.mjs",
    "check:locale": "node scripts/check-locale-pinning.mjs",
    "check:links": "node scripts/check-reciprocal-links.mjs",
    "typecheck:shared-types": "tsc --project packages/shared-types/tsconfig.test.json",
    "email:smoke": "node scripts/send-test-email.mjs",
    "test:email": "node --test --test-isolation=none scripts/send-test-email.test.mjs",
    "persistence:spike": "node --env-file-if-exists=.env scripts/persistence-spike.mjs",
    "test:persistence": "node --test --test-isolation=none scripts/persistence-spike.test.mjs",
    "test:notion-sync": "node --test --test-isolation=none scripts/sync-notion.test.mjs",
    "check:task-ids": "node scripts/check-task-ids.mjs",
    "check:policy": "node scripts/check-policy-constants.mjs",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "check:publish": "node scripts/check-publish-safety.mjs",
    "check:backlog": "node scripts/sync-notion.mjs",
    "check:evidence": "node scripts/check-evidence-hashes.mjs",
    "check:crossing": "node scripts/check-crossing-evidence.mjs",
    "check:workflows": "node scripts/check-workflow-timeouts.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:fast": "vitest run",
    "test:evidence-integrity": "node --test --test-isolation=none scripts/verify-evidence-integrity.test.mjs",
    "test:engine-output": "node --test --test-isolation=none scripts/engine-output.test.mjs",
    "engine:execute": "node scripts/engine-execute.mjs",
    "test:engine-recorder": "node --test --test-isolation=none scripts/engine-recorder.test.mjs",
    "email:notify": "pnpm build && node scripts/email-notify.mjs",
    "engine:alert-run": "pnpm build && node scripts/engine-alert-run.mjs",
    "test:alert-journal": "node --test --test-isolation=none scripts/run-journal.test.mjs",
    "scheduler:watch": "pnpm build && node scripts/scheduler-watch.mjs",
    "test:scheduler-watch": "node --test --test-isolation=none scripts/scheduler-watch.test.mjs",
    "test:failure-rehearsal": "node --test --test-isolation=none scripts/rehearse-engine-alerts.test.mjs",
    "capture:crossing": "node scripts/capture-crossing-probe.mjs",
    "verify:crossing": "node scripts/verify-crossing-capture.mjs",
    "test:crossing-capture": "node --test --test-isolation=none scripts/capture-crossing-probe.test.mjs scripts/verify-crossing-capture.test.mjs",
    "test:save-proof": "node --test --test-isolation=none scripts/run-save-proof.test.mjs",
    "test:proof-runtime": "node --test --test-isolation=none scripts/build-proof-runtime.test.mjs",
    "check:schedule": "node scripts/render-crossing-schedule.mjs --check",
    "schedule:render": "node scripts/render-crossing-schedule.mjs",
    "check:cadence": "node scripts/check-cadence-quotes.mjs",
    "measure:cadence": "pnpm build && node scripts/measure-scheduler-cadence.mjs",
    "verify:expiry": "node scripts/reassess-expiry-capture.mjs",
    "test:expiry-assessment": "node --test --test-isolation=none scripts/reassess-expiry-capture.test.mjs",
    "check:sow": "node scripts/check-sow-completeness.mjs",
    "ready:fresh": "node scripts/ready-fresh-machine.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stellar/stellar-sdk": "17.0.1",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
