{
  "name": "evergreen-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Soroban state-archival autopilot \u2014 monitor TTL, predict archival, extend automatically.",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "typecheck": "tsc --build --force && pnpm typecheck:shared-types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && pnpm test:ttl && pnpm test:scheduler && pnpm test:email && pnpm test:persistence",
    "test:ttl": "node --test --test-isolation=none scripts/verify-ttl-boundary.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "pnpm check:conflicts && pnpm check:task-ids && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "scheduler:smoke": "node scripts/scheduler-smoke.mjs",
    "test:scheduler": "node --test --test-isolation=none scripts/scheduler-smoke.test.mjs",
    "check:conflicts": "node scripts/check-conflict-markers.mjs",
    "typecheck:shared-types": "tsc --project packages/shared-types/tsconfig.test.json",
    "email:smoke": "node --env-file-if-exists=.env scripts/send-test-email.mjs",
    "test:email": "node --test --test-isolation=none scripts/send-test-email.test.mjs",
    "persistence:spike": "node --env-file-if-exists=.env scripts/persistence-spike.mjs",
    "test:persistence": "node --test --test-isolation=none scripts/persistence-spike.test.mjs",
    "check:task-ids": "node scripts/check-task-ids.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stellar/stellar-sdk": "17.0.1",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
