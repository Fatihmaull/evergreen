# Evergreen — environment template.
#
# Copy to `.env` and fill in locally. `.env` is gitignored and must stay that way.
# Real values live ONLY in: your local .env, GitHub Actions secrets, and the
# hosting platform's env store. Never a doc, an issue, a commit, or a chat log.
#
# Testnet keys are still treated as secrets. They aren't worth anything — the
# habit is what protects the mainnet keys later. (docs/CONVENTIONS.md)

# --- Network -----------------------------------------------------------------
# Soroban testnet RPC endpoint. Not secret, but env-driven so a testnet reset or
# a provider change is a config edit, not a code change.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Testnet network passphrase. TESTNET ONLY — mainnet is out of scope for this
# grant and there is no code path for it (CLAUDE.md hard rule 1).
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Separate developer key for disposable Testnet deployments and manual tests.
# Leave blank until generated locally. Never reuse a key controlling real funds.
EVERGREEN_DEV_SECRET=

# --- Engine signer -----------------------------------------------------------
# Ed25519 secret for the bot account (Stage 1). TESTNET ONLY.
# This account holds only enough XLM to pay extendTTL fees and has no authority
# over any contract — it doesn't need any, because extendTTL is permissionless.
# Treat it as a hot, expendable key (AGENTS.md hard rule 4).
EVERGREEN_SIGNER_SECRET=

# --- Notifications -----------------------------------------------------------
# Email provider API key (W1-D5-04). Secret store only.
EMAIL_API_KEY=
# Where bump success/failure alerts go.
EVERGREEN_ALERT_TO=

# --- Config ------------------------------------------------------------------
# Path to evergreen.config.json — the contract list and thresholds shared by the
# CLI and the engine so their behavior can't drift.
EVERGREEN_CONFIG_PATH=./evergreen.config.json
