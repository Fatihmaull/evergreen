[Unit]
Description=Evergreen one-shot controlled save proof
[Service]
Type=oneshot
EnvironmentFile=/ABSOLUTE/PRIVATE/proof.env
ExecStart=/ABSOLUTE/NODE /ABSOLUTE/PINNED/scripts/run-save-proof.mjs --manifest /ABSOLUTE/PRIVATE/campaign.json --submit --send-alerts
TimeoutStartSec=300
SuccessExitStatus=1
NoNewPrivileges=true
# Arm once at a reviewed UTC instant. Keep the attempt journal across restarts.
