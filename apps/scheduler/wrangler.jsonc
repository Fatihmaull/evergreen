// The scheduler Worker (apps/scheduler/README.md, docs/PH2-E4-04-SCHEDULER-DESIGN.md §8).
// Production (top-level block) is DEPLOYED (2026-10-31 04:33 UTC, scheduler-deploy.yml run
// 41168994480, approved by Fatih) and its */15 cron is LIVE. scheduler-deploy.yml deploys it only on
// a manual run with target=production, behind the `production` environment gate; merging this
// file changes nothing until such a run. 0009 is applied on production (2026-10-31). See docs/ops/deploy.md.
// Worker secrets, set per environment with `wrangler secret put <NAME> --env preview`:
//   DATABASE_URL  the eg_scheduler role's connection string (never the owner's)
//   TICK_TOKEN    bearer token that turns POST /tick on (preview only)
// No account_id: wrangler reads it from CLOUDFLARE_ACCOUNT_ID or the logged-in account.
{
  "name": "evergreen-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  // Production cron every 15 minutes (PH2-E4-04, design §8). Live since the 2026-10-31 production deploy.
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false },
  },
  "vars": { "ENVIRONMENT": "production" },
  "env": {
    "preview": {
      "name": "evergreen-scheduler-preview",
      // workers.dev so POST /tick and GET /health are reachable; no route, no custom domain.
      "workers_dev": true,
      // Preview: */15 like production, from 2026-11-23 (PH2-E4-04). Hosted autopilot is live here on
      // testnet (HOSTED_MODE=live), so top-ups must run without a manual tick. Workers Paid (30 s CPU).
      // POST /tick still works for a manual tick. Was [] since PR #519.
      "triggers": { "crons": ["*/15 * * * *"] },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": { "invocation_logs": false },
      },
      // Stage 2 (PH2-E4-04, #643). Retry margin on testnet decided 2026-11-23 (CEF, recorded on
      // #643). HOSTED_MODE=live on preview only (testnet), 2026-11-23, after fatih set the
      // preview ENGINE_SECRET (spender GBNCEF5F...J6AM). Production has no HOSTED_MODE and no
      // engine secret, so it stays dry-run until DoD-2.
      "vars": {
        "ENVIRONMENT": "preview",
        "ALLOWANCE_RETRY_MARGIN_STROOPS": "100000",
        "HOSTED_MODE": "live",
        // PH2-E4-03 sweep buffer, PROVISIONAL (Fatih, 2026-11-27, #689; revisit after DoD-2,
        // about 2026-12-07): 1 XLM account reserve + 1 XLM operating fees. SWEEP_MODE is not set,
        // so the sweep stays dry-run. Production has no buffer.
        "SWEEP_BUFFER_STROOPS": "20000000",
      },
    },
  },
}
