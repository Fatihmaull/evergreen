// The API Worker (docs/API.md §1). No secrets here. Worker secrets, set with
// `wrangler secret put <NAME> [--env preview]` per environment:
//   DATABASE_URL           Neon Postgres connection string
//   SIGNIN_CODE_PEPPER     HMAC key sign-in codes are stored under
//   EMAIL_API_KEY          Resend API key (same name as the engine's)
//   CHALLENGE_SIGNING_KEY  S… seed of the unfunded SEP-10 challenge-signing key
// Plain vars auth also needs (not secret):
//   DASHBOARD_ORIGIN  set below per environment (one exact origin, no wildcard)
//   EMAIL_FROM        alerts@mail.evergreenstellar.biz.id on both environments
//                     (Resend domain mail.evergreenstellar.biz.id, verified)
// Until all of these are set, the auth routes answer 503 UPSTREAM_UNAVAILABLE.
// No account_id: wrangler reads it from CLOUDFLARE_ACCOUNT_ID or the
// logged-in account.
{
  "name": "evergreen-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  // Workers Logs, so auth.email_send_failed (docs/API.md §9) can be read. Console output
  // only: invocation logs are OFF because they record the whole request, and the
  // platform redacts Cookie and Authorization but NOT X-Evergreen-CSRF, the client IP
  // or the user agent (observed with `wrangler tail`, docs/ops/observability.md).
  // Production: the F10/F11 checks every 15 minutes (PM, 2026-10-31: Neon budget).
  // Live once the API is deployed with this file.
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false,
    },
  },
  "vars": {
    "ENVIRONMENT": "production",
    // 3 x the prod scheduler interval (*/15 = 900 s); worst detection ~3600 s with a */15 check.
    "HEARTBEAT_STALE_SECONDS": "2700",
    // Same as preview (PM-approved 2026-10-31).
    "TESTNET_RESET_LOOKBACK_TICKS": "12",
    "THRESHOLD_FLOOR_LEDGERS": "1037",
    "DASHBOARD_ORIGIN": "https://evergreen-stellar.pages.dev",
    "EMAIL_FROM": "alerts@mail.evergreenstellar.biz.id",
  },
  "env": {
    "preview": {
      "name": "evergreen-api-preview",
      "workers_dev": false,
      // Preview: no cron (F9 24h data done, PR #519). F10/F11 run via manual dispatch/tick only.
      "triggers": { "crons": [] },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "invocation_logs": false,
        },
      },
      "vars": {
        "ENVIRONMENT": "preview",
        "HEARTBEAT_STALE_SECONDS": "900",
        // F10 testnet-reset check (src/alerts/testnet-reset.ts): compare the last 12 ticks (~1 h at */5).
        "TESTNET_RESET_LOOKBACK_TICKS": "12",
        // Watchlist floor (src/watchlist/mount.ts): 4 x worst preview tick gap 259 + 1 (packages/core/src/scheduler-gap.ts). Preview only.
        "THRESHOLD_FLOOR_LEDGERS": "1037",
        "DASHBOARD_ORIGIN": "https://preview.evergreen-stellar.pages.dev",
        "EMAIL_FROM": "alerts@mail.evergreenstellar.biz.id",
      },
    },
  },
}
