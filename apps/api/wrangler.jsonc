// The API Worker (docs/API.md §1). No secrets here: the challenge-signing key,
// the Resend key, DATABASE_URL and SIGNIN_CODE_PEPPER are Worker secrets, set
// with `wrangler secret put` per environment. No account_id: wrangler reads it
// from CLOUDFLARE_ACCOUNT_ID or the logged-in account.
{
  "name": "evergreen-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "vars": { "ENVIRONMENT": "production" },
  "env": {
    "preview": {
      "name": "evergreen-api-preview",
      "workers_dev": false,
      "vars": { "ENVIRONMENT": "preview" },
    },
  },
}
