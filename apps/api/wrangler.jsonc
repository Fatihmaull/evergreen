// The API Worker (docs/API.md §1). No secrets here. Worker secrets, set with
// `wrangler secret put <NAME> [--env preview]` per environment:
//   DATABASE_URL           Neon Postgres connection string
//   SIGNIN_CODE_PEPPER     HMAC key sign-in codes are stored under
//   EMAIL_API_KEY          Resend API key (same name as the engine's)
//   CHALLENGE_SIGNING_KEY  S… seed of the unfunded SEP-10 challenge-signing key
// Plain vars auth also needs (not secret):
//   DASHBOARD_ORIGIN  set below per environment (one exact origin, no wildcard)
//   EMAIL_FROM        preview: onboarding@resend.dev (env.preview vars; only delivers
//                     to the Resend account owner's email); production undetermined
//                     until the Resend sender domain is verified
// Until all of these are set, the auth routes answer 503 UPSTREAM_UNAVAILABLE.
// No account_id: wrangler reads it from CLOUDFLARE_ACCOUNT_ID or the
// logged-in account.
{
  "name": "evergreen-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  // Workers Logs, so auth.email_send_failed (docs/API.md §9) can be read.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "ENVIRONMENT": "production",
    "DASHBOARD_ORIGIN": "https://evergreen-stellar.pages.dev",
  },
  "env": {
    "preview": {
      "name": "evergreen-api-preview",
      "workers_dev": false,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
      "vars": {
        "ENVIRONMENT": "preview",
        "DASHBOARD_ORIGIN": "https://preview.evergreen-stellar.pages.dev",
        "EMAIL_FROM": "onboarding@resend.dev",
      },
    },
  },
}
